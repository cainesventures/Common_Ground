# ── Database ─────────────────────────────────────────────────────────────────
# Defaults to SQLite (no setup required). Change to PostgreSQL for production.
DATABASE_URL=sqlite:///./common_ground_test.db
# DATABASE_URL=postgresql://user:password@localhost:5432/common_ground_db

# ── AI — Claude (Required for Claude agents) ─────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Legislation APIs (Optional) ───────────────────────────────────────────────
# Congress.gov API key — free, get one at https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# ── Local AI / Ollama (Optional) ─────────────────────────────────────────────
# Only needed if using local models. Install Ollama from https://ollama.com
OLLAMA_URL=http://localhost:11434/api/generate

# ── Sharing URLs ──────────────────────────────────────────────────────────────
# Set this to your public domain in production for correct social share links.
APP_BASE_URL=http://localhost:8000

# ── Local / Municipal Legislation (Optional) ─────────────────────────────────
# Legistar/Granicus API key — required by some cities (e.g. NYC), optional for most.
# Philadelphia slug: "Philadelphia" | NYC slug: "nyc" | Seattle slug: "Seattle"
# Find your city at https://webapi.legistar.com/Help
LEGISTAR_API_KEY=

# ── Google OAuth (Required for user accounts) ────────────────────────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Strong random string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
# Base URL for the OAuth redirect URI (must match what you set in Google Cloud Console)
APP_URL=http://localhost:8000
# Next.js frontend URL — used for OAuth redirect after Google login
FRONTEND_URL=http://localhost:3000

# ── AI Video Generation (Optional) ───────────────────────────────────────────
# HeyGen API key — get one at https://www.heygen.com
# Free tier: 10 credits/month (~10 min of video). ~$1/min after that.
HEYGEN_API_KEY=

# ── Research Providers (Optional — free providers used by default) ────────────
# Without these, DuckDuckGo + Wikipedia are used (no keys required, no cost).
# Add either key to upgrade to a paid research provider automatically.
# Perplexity — https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
# Tavily — https://app.tavily.com
TAVILY_API_KEY=

# ── OpenStates API (Optional — for state legislation ingestion) ───────────────
# Free tier available. Get a key at https://openstates.org/api/register/
OPENSTATES_API_KEY=

# ── Background Tasks / Celery (Required for auto-debate pipeline) ─────────────
# Start worker:  celery -A app.celery_app worker --loglevel=info
# Start beat:    celery -A app.celery_app beat --loglevel=info  (hourly auto-debates)
REDIS_URL=redis://localhost:6379/0

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
